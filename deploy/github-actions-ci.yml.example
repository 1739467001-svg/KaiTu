name: Validate KaiTu
on: [push, pull_request]
permissions:
  contents: read
jobs:
  test-and-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22.22.1'
          cache: npm
      - run: npm ci
      - run: npm test
      - run: npm run build
      - run: docker build --target runtime -t kaitu:test .
      - run: docker build --target worker -t kaitu-worker:test .
